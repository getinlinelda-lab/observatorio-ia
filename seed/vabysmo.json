      "rcm_version": "EMA PT 2026-06-25"
    },
    {
      "id": "CI-2",
      "type": "Contraindicação",
      "section": "4.3",
      "text": "Inflamação intraocular ativa",
      "weight": "crítico",
      "rcm_version": "EMA PT 2026-06-25"
    },
    {
      "id": "ADV-1",
      "type": "Advertência",
      "section": "4.4",
      "text": "Endoftalmite, inflamação intraocular, descolamento ou rasgadura da retina associados a injeções intravítreas",
      "weight": "crítico",
      "rcm_version": "EMA PT 2026-06-25"
    },
    {
